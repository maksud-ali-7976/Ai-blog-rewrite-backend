{
  "name": "ai-story-book",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "worker": "bun run --watch src/worker.ts",
    "build:api": "bun build src/index.ts --outdir ./build --target=node --external pdfkit --external node-appwrite",
    "build:worker": "bun build src/worker.ts --outdir ./build --target=node --external pdfkit --external node-appwrite",
    "build": "bun run build:api && bun run build:worker",
    "start": "bun build/index.js",
    "start:worker": "bun build/worker.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@elysiajs/bearer": "^1.2.0",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/html": "^1.4.2",
    "@elysiajs/static": "^1.2.0",
    "@elysiajs/stream": "^1.1.0",
    "@elysiajs/swagger": "^1.1.6",
    "@sinclair/typebox": "^0.34.0",
    "@typegoose/typegoose": "^12.9.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/consola": "^2.2.8",
    "@types/jsonwebtoken": "^9.0.9",
    "agenda": "^5.0.0",
    "agora-token": "^2.0.4",
    "ai": "^6.0.168",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.5",
    "cheerio": "^1.2.0",
    "consola": "^3.4.2",
    "cron": "^4.3.0",
    "dotenv": "^16.5.0",
    "elysia": "^1.4.28",
    "elysia-helmet": "^2.0.0",
    "firebase": "^11.6.0",
    "form-data": "^4.0.2",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.8.0",
    "node-appwrite": "15.0.1",
    "nodemailer": "^6.10.1",
    "openmeteo": "^1.2.0",
    "pdfkit": "^0.17.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/sharp": "^0.32.0",
    "@webpack-cli/generators": "^3.0.7",
    "bun-types": "^1.2.9",
    "mongoose-tsgen": "^9.5.0",
    "webpack-cli": "^6.0.1"
  },
  "module": "src/index.js"
}